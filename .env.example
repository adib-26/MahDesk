APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# Passwords: Argon2id (config/hashing.php). Older bcrypt hashes are upgraded at sign-in.
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
# Reject breached passwords via Have I Been Pwned (free). Defaults to on in production.
# PASSWORD_CHECK_BREACHED=true

# Security headers (config/security.php). HSTS defaults to on in production.
# SECURITY_HSTS=true
# SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_REPORT_URI=
# Load balancer / reverse proxy addresses, comma separated, or *.
# TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local email is captured by Mailpit. Open http://localhost:8025 to view it.
MAIL_MAILER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email-to-ticket. With testmail.app, each workspace receives mail at
# {TESTMAIL_NAMESPACE}.{workspace-slug}@inbox.testmail.app and
# `php artisan desk:poll-testmail` (scheduled every minute) imports it.
# Get the namespace and API key from https://testmail.app/console.
INBOUND_EMAIL_DRIVER=testmail
TESTMAIL_NAMESPACE=
TESTMAIL_API_KEY=

# Only for INBOUND_EMAIL_DRIVER=postmark: workspaces receive mail at
# {slug}@INBOUND_EMAIL_DOMAIN and the webhook rejects requests until
# INBOUND_EMAIL_SECRET is set.
INBOUND_EMAIL_DOMAIN=inbound.mahbubdesk.test
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_MAX_PAYLOAD_BYTES=5242880
INBOUND_EMAIL_MAX_RECIPIENTS=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
